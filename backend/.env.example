# Document safe local defaults here. Never put secrets in this file.
# Copy to backend/.env. Never commit the local .env file.
ENVIRONMENT=development
DATABASE_URL=sqlite:///./datasets/datatrace.db
STORAGE_DIR=datasets/generated/uploads
OUTPUT_DIR=datasets/output
QUARANTINE_DIR=datasets/quarantine
CUSTOMER_MASTER_PATH=datasets/sample/customer_master.csv
MERCHANT_MASTER_PATH=datasets/sample/merchant_master.csv
MAX_UPLOAD_BYTES=10485760
MAX_PROCESSING_ROWS=500000
PROFILE_SAMPLE_SIZE=5000
AI_PROVIDER=openrouter
OPENROUTER_API_KEY=
OPENROUTER_MODEL=z-ai/glm-5.3-flash
AI_TIMEOUT_SECONDS=12
AI_MAX_RETRIES=0
AI_BUDGET_USD=1.00
AI_MAX_INPUT_TOKENS=1800
AI_MAX_OUTPUT_TOKENS=1200
AI_INPUT_COST_PER_MILLION_USD=0.075
AI_OUTPUT_COST_PER_MILLION_USD=0.25
AI_CACHE_ENABLED=true
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
LOG_LEVEL=INFO
