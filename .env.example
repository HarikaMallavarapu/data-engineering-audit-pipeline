# Local development reference. The backend loads backend/.env.
ENVIRONMENT=development
DATABASE_URL=sqlite:///./datasets/datatrace.db
STORAGE_DIR=datasets/generated/uploads
OUTPUT_DIR=datasets/output
QUARANTINE_DIR=datasets/quarantine
CUSTOMER_MASTER_PATH=datasets/sample/customer_master.csv
MERCHANT_MASTER_PATH=datasets/sample/merchant_master.csv
MAX_UPLOAD_BYTES=10485760
# Set AI_PROVIDER=auto to prefer OpenRouter, then Gemini, based on configured keys.
# Schema inference sends column names and aggregate/profile metadata, never source row values.
AI_PROVIDER=openrouter
OPENROUTER_API_KEY=
OPENROUTER_MODEL=z-ai/glm-5.3-flash
AI_BUDGET_USD=1.00
AI_MAX_INPUT_TOKENS=1800
AI_MAX_OUTPUT_TOKENS=1200
AI_MAX_RETRIES=0
AI_INPUT_COST_PER_MILLION_USD=0.075
AI_OUTPUT_COST_PER_MILLION_USD=0.25
AI_CACHE_ENABLED=true
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
AI_TIMEOUT_SECONDS=12
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
LOG_LEVEL=INFO
